QSlider::groove:horizontal {
    border: 1px solid #bcbcbc;
    background: white;
    height: 2px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #b4b4b4, stop:1 #8f8f8f);
    border: 1px solid #5c5c5c;
    width: 13px;
    margin-top: -2px;
    margin-bottom: -2px;
    border-radius: 2px;
}
QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #d7d7d7, stop:1 #bed7de);
}
QSlider::add-page:horizontal {
    background: #00BFFF;
}
QSlider::sub-page:horizontal {
    background: #00FFFF;
}
QSlider::add-line:horizontal {
    border: 1px solid #bbb;
    background: white;
    width: 10px;
    subcontrol-position: right;
    subcontrol-origin: margin;
}
QSlider::sub-line:horizontal {
    border: 1px solid #bbb;
    background: white;
    width: 10px;
    subcontrol-position: left;
    subcontrol-origin: margin;
}
QSlider::up-arrow:horizontal, QSlider::down-arrow:horizontal {
    background: none;
}
QSlider::add-page:vertical, QSlider::sub-page:vertical {
    background: none;
}